# TikTok Pixel Configuration for Lala Fashion Store
# Copy this file as .env.local and fill in your values
# IMPORTANT: Add .env.local to .gitignore to keep tokens secret

# ============================================
# TIKTOK PIXEL CONFIGURATION
# ============================================

# Your TikTok Pixel ID (public - safe to share)
NEXT_PUBLIC_TIKTOK_PIXEL_ID=D99L713C77U03DOJCBLG

# Your TikTok Pixel Name (for reference)
NEXT_PUBLIC_TIKTOK_PIXEL_NAME=LALAFASHION

# ============================================
# TIKTOK CONVERSIONS API
# ============================================

# Access Token (KEEP SECRET - only in .env.local)
# Get this from: https://ads.tiktok.com/ 
# Path: Business Center → Settings → Events → Conversions API
TIKTOK_ACCESS_TOKEN=your_access_token_here

# TikTok Conversions API Endpoint (usually doesn't change)
TIKTOK_CONVERSIONS_API_URL=https://business-api.tiktok.com/open_api/v1.3/pixel/track/

# API version (current)
TIKTOK_API_VERSION=v1.3

# ============================================
# OPTIONAL CONFIGURATION
# ============================================

# Environment (development, staging, production)
NODE_ENV=development

# Enable debug logging (set to true for troubleshooting)
DEBUG_TIKTOK_EVENTS=false

# Default currency for all events
DEFAULT_CURRENCY=PKR

# Website URL (for server-side tracking)
WEBSITE_URL=https://lalafashion.store

# ============================================
# SETUP INSTRUCTIONS
# ============================================

# 1. RENAME THIS FILE:
#    cp .env.local.example .env.local
#
# 2. GET YOUR ACCESS TOKEN:
#    - Login to https://ads.tiktok.com/
#    - Go to Business Center → Settings → Events
#    - Click "Conversions API"
#    - Click "Generate Access Token"
#    - Copy the token and paste below
#
# 3. PASTE YOUR TOKEN:
#    Replace "your_access_token_here" with actual token
#
# 4. ADD TO .gitignore:
#    Make sure .env.local is in your .gitignore file
#    This prevents accidentally committing secrets to git
#
# 5. RESTART YOUR DEV SERVER:
#    npm run dev
#    The new environment variables will be loaded

# ============================================
# SECURITY NOTES
# ============================================

# NEVER:
# - Commit .env.local to git
# - Share your access token publicly
# - Paste token in code comments or files
# - Share token in emails or Slack

# DO:
# - Keep token in .env.local only
# - Rotate token every 90 days
# - Use different tokens for dev/staging/production
# - Regenerate if token is exposed

# ============================================
# TESTING YOUR SETUP
# ============================================

# After setting up, test with:
# 
# Browser console:
# window.ttq.track('PageView');
#
# Server-side:
# curl -X POST http://localhost:3000/api/tiktok-track \
#   -H "Content-Type: application/json" \
#   -d '{"event_type":"Purchase","data":{"value":5000,"currency":"PKR"}}'
#
# Check TikTok dashboard for events within 5-15 minutes

# ============================================
# TROUBLESHOOTING
# ============================================

# Error: "Access Token Invalid"
# → Token might be expired, regenerate in TikTok
# → Ensure token is pasted correctly (no spaces)
# → Check token hasn't been rotated in another browser
#
# Error: "CORS error"
# → Ensure API URL is correct
# → Check Content-Type header is application/json
#
# No events appearing in TikTok dashboard
# → Wait 5-15 minutes (not real-time)
# → Check browser console for JavaScript errors
# → Verify pixel ID is correct
# → Test with browser console method above
